# Clube do Livro — API pública do acervo (Laravel/Sistema-Quality)
# Local dev: 127.0.0.1:8001 assumes `php artisan serve --port=8001` in Sistema-Quality.
# Production: Sistema-Quality runs behind Apache/mod_php with no port of its own —
# use its public ServerName instead (see CLAUDE.md's Deployment section).
LIVROS_API_URL=http://127.0.0.1:8001/api/livros

# Base das rotas v1 do Sistema-Quality (autenticação e retirada)
API_V1_URL=http://127.0.0.1:8001/api/v1
